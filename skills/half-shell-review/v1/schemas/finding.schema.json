{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://half-shell.dev/protocol/v1/finding.schema.json",
  "title": "Half-Shell Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "severity",
    "confidence",
    "category",
    "file",
    "claim",
    "evidence",
    "failure_mode",
    "suggested_fix",
    "corroboration_count"
  ],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "category": {
      "type": "string",
      "enum": ["bug", "regression", "security", "contract", "incomplete_change", "missing_test", "undocumented_behavior", "operational"]
    },
    "file": {"type": "string", "minLength": 1},
    "line": {"type": ["integer", "null"], "minimum": 1},
    "start_line": {"type": ["integer", "null"], "minimum": 1},
    "claim": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "failure_mode": {"type": "string", "minLength": 1},
    "suggested_fix": {"type": "string", "minLength": 1},
    "corroboration_count": {"type": "integer", "minimum": 1},
    "corroborating_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    }
  }
}
