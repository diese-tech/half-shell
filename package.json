{
  "name": "half-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Adversarial multi-agent pull request review. The Dojo reviews, Leonardo publishes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "half-shell": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "review": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "harness": "node dist/harness/run.js"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
