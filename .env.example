# --- GitHub App ---------------------------------------------------------
GITHUB_APP_ID=123456
# PEM contents, either raw (with real newlines) or base64-encoded
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Login of the app bot account, used to ignore Half-Shell's own comments
GITHUB_APP_LOGIN=half-shell[bot]

# --- Server -------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# --- Inference routing --------------------------------------------------
# Ordered fallback chain. Each id needs matching HALF_SHELL_PROVIDER_<ID>_* vars.
# Known ids (groq, openrouter, ollama) carry sensible base-url and tier defaults.
HALF_SHELL_PROVIDERS=groq,openrouter,ollama

HALF_SHELL_PROVIDER_GROQ_API_KEY=
HALF_SHELL_PROVIDER_GROQ_MODEL=llama-3.3-70b-versatile

HALF_SHELL_PROVIDER_OPENROUTER_API_KEY=
HALF_SHELL_PROVIDER_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

HALF_SHELL_PROVIDER_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
HALF_SHELL_PROVIDER_OLLAMA_MODEL=qwen2.5-coder:14b

# Paid tiers are skipped unless this is explicitly true. Never flip it silently.
HALF_SHELL_ALLOW_PAID_INFERENCE=false

# --- Review behaviour ---------------------------------------------------
# Max changed files pulled into context for one review
HALF_SHELL_MAX_FILES=40
# Max patch characters per file handed to a reviewer
HALF_SHELL_MAX_PATCH_CHARS=12000
# Max characters for the whole rendered change in one prompt; files that do not
# fit are reported as omitted rather than silently dropped
HALF_SHELL_MAX_PROMPT_CHARS=120000
# Skip publishing and just log the verdict
HALF_SHELL_DRY_RUN=false
# file (JSON per pull request) or sqlite (single database, survives restarts)
HALF_SHELL_STORE=file
# Where run records and finding state are persisted. LEAVE THESE UNSET when
# running the container: the image sets them to the mounted /data volume, and
# an --env-file entry would override it with an unwritable relative path.
# HALF_SHELL_DATA_DIR=.half-shell
# HALF_SHELL_DATABASE_PATH=.half-shell/half-shell.db

# --- Related context ----------------------------------------------------
# Files pulled in as background beyond the diff; 0 disables
HALF_SHELL_MAX_RELATED_FILES=5
HALF_SHELL_MAX_RELATED_CHARS=6000
# Ceiling on GitHub requests spent gathering related context per review. The
# file budget bounds results, not work — a repo whose tests do not match the
# conventions never fills it, so this is what stops the probing.
HALF_SHELL_MAX_RELATED_LOOKUPS=30
# Look up files mentioning the changed file via code search. This is a
# full-text basename match, not call-graph analysis (rate-limited, degrades
# silently, and stops for the run after the first rejection).
HALF_SHELL_SEARCH_CALLERS=true
