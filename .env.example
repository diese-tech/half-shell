# --- GitHub App ---------------------------------------------------------
GITHUB_APP_ID=123456
# PEM contents, either raw (with real newlines) or base64-encoded
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Login of the app bot account, used to ignore Half-Shell's own comments
GITHUB_APP_LOGIN=half-shell[bot]

# --- Server -------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# --- Inference routing --------------------------------------------------
# Ordered fallback chain. Each id needs matching HALF_SHELL_PROVIDER_<ID>_* vars.
# Known ids (groq, openrouter, ollama) carry sensible base-url and tier defaults.
HALF_SHELL_PROVIDERS=groq,openrouter,ollama

HALF_SHELL_PROVIDER_GROQ_API_KEY=
HALF_SHELL_PROVIDER_GROQ_MODEL=llama-3.3-70b-versatile

HALF_SHELL_PROVIDER_OPENROUTER_API_KEY=
HALF_SHELL_PROVIDER_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

HALF_SHELL_PROVIDER_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
HALF_SHELL_PROVIDER_OLLAMA_MODEL=qwen2.5-coder:14b

# Paid tiers are skipped unless this is explicitly true. Never flip it silently.
HALF_SHELL_ALLOW_PAID_INFERENCE=false

# --- Review behaviour ---------------------------------------------------
# Max changed files pulled into context for one review
HALF_SHELL_MAX_FILES=40
# Max patch characters per file handed to a reviewer
HALF_SHELL_MAX_PATCH_CHARS=12000
# Skip publishing and just log the verdict
HALF_SHELL_DRY_RUN=false
# Where run records and finding state are persisted
HALF_SHELL_DATA_DIR=.half-shell
