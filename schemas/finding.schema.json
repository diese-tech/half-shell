{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://half-shell.dev/orchestration/v1/finding.schema.json",
  "title": "Half-Shell Council Finding v1",
  "description": "A finding as it moves through Synthesis, Sparring, and Leo's verdict. source_persona is always stored, even when the Sparring payload anonymizes it. See Issue #12 sections 7, 8, 9, 15.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "review_id",
    "source_persona",
    "category",
    "claim",
    "evidence",
    "affected_code",
    "consequence",
    "confidence",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "review_id": { "type": "string", "minLength": 1 },
    "source_persona": {
      "type": "string",
      "enum": ["leo", "raph", "donnie", "mikey", "splinter", "april", "casey", "shredder"],
      "description": "Internal provenance. Never sent to Sparring — the anonymous payload strips this."
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "regression",
        "security",
        "contract",
        "incomplete_change",
        "missing_test",
        "undocumented_behavior",
        "operational",
        "human_experience",
        "operational_abuse",
        "engineering_discipline"
      ]
    },
    "claim": { "type": "string", "minLength": 1 },
    "evidence": { "type": "string", "minLength": 1 },
    "affected_code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "start_line": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "consequence": {
      "type": "string",
      "minLength": 1,
      "description": "The concrete failure mode or impact — what actually happens because of this."
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "surviving_sparring",
        "narrowed",
        "merged",
        "withdrawn",
        "investigation_requested",
        "published",
        "rejected"
      ]
    },
    "reproduction": { "type": ["string", "null"] },
    "proposed_fix": { "type": ["string", "null"] },
    "severity": {
      "type": ["string", "null"],
      "enum": ["critical", "high", "medium", "low", null]
    },
    "historical_context": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "recurring": { "type": "boolean" },
        "prior_finding_ids": { "type": "array", "items": { "type": "string" } },
        "lesson": { "type": ["string", "null"] }
      }
    },
    "related_findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "corroboration": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "shared_assumption",
            "repeated_unsupported_assumption",
            "independent_same_evidence",
            "independent_distinct_evidence"
          ]
        },
        "confidence_effect": {
          "type": "string",
          "enum": ["no_confidence_gain", "confidence_penalty", "small_confidence_gain", "strong_confidence_gain"]
        },
        "contributing_source_personas": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "root_cause": { "type": ["string", "null"] }
  }
}
